+	"log", "hash", "diff-closures",
+]);
+
+function isSafeNixCommand(args: string[]): boolean {
+	const subcommand = args[0];
+	if (!subcommand) return false;
+	const action = args[1];
+	if (NIX_SAFE_SUBCOMMANDS.has(subcommand)) return true;
+	switch (subcommand) {
+		case "flake":
+			return ["show", "metadata", "verify", "archive"].includes(action ?? "");
+		case "profile":
+			return action === "list";
+		case "config":
+			return action === "show";
+		case "registry":
+			return action === "list";
+		case "store":
+			return ["ls", "stat", "ping", "verify", "info"].includes(action ?? "");
+		case "derivation":
+			return action === "show";
+		default:
+			return false;
+	}
+}
+
+function invokesNixRepl(words: string[]): boolean {
+	let index = 0;
+	if (words[0]?.toLowerCase() === "sudo") index = 1;
+	if (words[index]?.toLowerCase() !== "nix") return false;
+	for (let position = index + 1; position < words.length; position++) {
+		const argument = words[position];
+		if (argument.startsWith("-")) continue;
+		return argument === "repl";
+	}
+	return false;
+}
