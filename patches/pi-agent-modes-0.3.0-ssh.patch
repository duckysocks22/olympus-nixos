+const SSH_VALUE_OPTIONS = new Set(["-o", "-p", "-l", "-i", "-F", "-J", "-b", "-c", "-m", "-Q"]);
+const SSH_ALLOWED_FLAGS = /^[46vqnTAaxXCs]+$/;
+
+function isSafeSshCommand(args: string[]): boolean {
+	let index = 0;
+	while (index < args.length) {
+		const argument = args[index];
+		if (!argument.startsWith("-")) break;
+		if (SSH_VALUE_OPTIONS.has(argument)) {
+			const value = args[index + 1];
+			if (value === undefined) return false;
+			if (argument === "-o" && /command/i.test(value)) return false;
+			index += 2;
+			continue;
+		}
+		if (argument === "-" || !SSH_ALLOWED_FLAGS.test(argument.slice(1))) return false;
+		index += 1;
+	}
+	const destination = args[index];
+	if (!destination) return false;
+	const remoteCommand = args.slice(index + 1);
+	if (remoteCommand.length === 0) return false;
+	return isSafeBashCommand(remoteCommand.join(" "));
+}
